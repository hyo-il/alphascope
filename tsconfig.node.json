{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  // 서버 프로세스가 실제로 쓰는 것만 포함한다.
  // src/services/analysis 등 브라우저 전용 코드는 tsconfig.app.json 이 담당한다.
  "include": [
    "vite.config.ts",
    "server",
    "scripts",
    "src/services/toss",
    "src/types",
    "src/utils"
  ]
}
