{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  // 서버 프로세스가 실제로 쓰는 것만 포함한다.
  // src/services/analysis 는 프롬프트 문구 정의(horizons.ts)를 서버의 Gemini 모듈과
  // 공유하므로 포함한다 — 브라우저 API 를 쓰지 않는 순수 모듈이다.
  "include": [
    "vite.config.ts",
    "server",
    "scripts",
    "src/services/analysis/horizons.ts",
    "src/services/toss",
    "src/types",
    "src/utils"
  ]
}
