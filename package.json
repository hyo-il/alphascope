{
  "name": "alphascope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api,py -c cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:py\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --ignore \"python/**\" --ignore \"db/**\" server/index.ts",
    "dev:py": "python/.venv/bin/python python/indicators.py",
    "py:setup": "/opt/homebrew/opt/python@3.12/bin/python3.12 -m venv python/.venv && python/.venv/bin/pip install -r python/requirements.txt",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:init": "tsx scripts/initDb.ts",
    "smoke": "tsx scripts/smokeTest.ts",
    "probe": "tsx scripts/probeApi.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "lightweight-charts": "^5.0.0",
    "lightweight-charts-drawing": "^0.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
