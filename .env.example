TOSS_CLIENT_ID=your_client_id
TOSS_CLIENT_SECRET=your_client_secret
TOSS_BASE_URL=https://openapi.tossinvest.com

# 앱 설정
API_PORT=4000
# API 서버가 바인딩할 주소. 기본은 루프백(이 컴퓨터에서만 접속 가능).
# 다른 기기에서 열어야 할 때만 0.0.0.0 으로 바꾼다 — 이 API 에는 인증이 없다.
# API_HOST=127.0.0.1
# 브라우저에서 직접 호출할 추가 오리진 (쉼표 구분). 보통 필요 없다 (Vite 프록시를 지난다).
# ALLOWED_ORIGINS=
INDICATORS_PORT=5001
POLLING_INTERVAL_MS=1000
DB_PATH=./db/alphascope.db

# Google Gemini API
GEMINI_API_KEY=your_api_key

# ── 테스트 서버 스위치 (v2.16.0) ──────────────────────────────────────────────
# 복사본 DB 로 띄운 테스트 서버가 실제 모의 주문·Gemini 호출을 하지 않게 끈다. 기본은 true(켜짐).
# AUTO_TRADING_ENABLED=false → 자동매매 스케줄러를 시작하지 않고 수동 실행도 막는다
#                             (화면에 "이 서버에서는 자동매매가 꺼져 있습니다" 가 뜬다)
# GEMINI_ENABLED=false      → 키가 있어도 Gemini 를 부르지 않는다 (/api/gemini/status 가 enabled:false + 이유)
# UNIVERSE_UPDATE_ENABLED=false → 서버가 server/data/universe.json 쓰기·월별 스냅샷 받기를 하지 않는다(읽기는 그대로, v2.41.0)
# US_HALTS_ENABLED=false    → 미국 거래정지(실험실) Nasdaq RSS 를 받지 않는다(평일 04:00~20:00 ET 1분마다, v2.55.0)
# BUYJUDGE_RECHECK_ENABLED=false → 미국 매수 판단을 20:45 ET 뒤 최종 일봉으로 다시 계산하지 않는다(달라진 것만 기록 · 토스 일봉 종목마다 1번, v2.58.0)
# MARKET_BRIEF_ENABLED=false → 오늘 시황 자동 오전판(평일 06:55 KST 뒤 첫 10분 확인)을 만들지 않는다 — 「시황 분석」 버튼은 그대로 동작(v2.59.0).
#                             켜 두면 RSS 8곳 · FRED · yfinance(실적 전망치 수백 번)를 부른다. 맥 개발 서버가 운영과 같은 Gemini 키를 쓰면 꺼 둔다
# GEMINI_BRIEF_MODEL=        → 오늘 시황만 다른 Gemini 모델로(비우면 GEMINI_MODEL · 기본 모델)
# AUTO_TRADING_ENABLED=true
# GEMINI_ENABLED=true
# UNIVERSE_UPDATE_ENABLED=true
# US_HALTS_ENABLED=true
# BUYJUDGE_RECHECK_ENABLED=true
# MARKET_BRIEF_ENABLED=true
