TOSS_CLIENT_ID=your_client_id
TOSS_CLIENT_SECRET=your_client_secret
TOSS_BASE_URL=https://openapi.tossinvest.com

# 앱 설정
API_PORT=4000
# API 서버가 바인딩할 주소. 기본은 루프백(이 컴퓨터에서만 접속 가능).
# 다른 기기에서 열어야 할 때만 0.0.0.0 으로 바꾼다 — 이 API 에는 인증이 없다.
# API_HOST=127.0.0.1
# 브라우저에서 직접 호출할 추가 오리진 (쉼표 구분). 보통 필요 없다 (Vite 프록시를 지난다).
# ALLOWED_ORIGINS=
INDICATORS_PORT=5001
POLLING_INTERVAL_MS=1000
DB_PATH=./db/alphascope.db

# Google Gemini API
GEMINI_API_KEY=your_api_key

# ── 테스트 서버 스위치 (v2.16.0) ──────────────────────────────────────────────
# 복사본 DB 로 띄운 테스트 서버가 실제 모의 주문·Gemini 호출을 하지 않게 끈다. 기본은 true(켜짐).
# AUTO_TRADING_ENABLED=false → 자동매매 스케줄러를 시작하지 않고 수동 실행도 막는다
#                             (화면에 "이 서버에서는 자동매매가 꺼져 있습니다" 가 뜬다)
# GEMINI_ENABLED=false      → 키가 있어도 Gemini 를 부르지 않는다 (/api/gemini/status 가 enabled:false + 이유)
# AUTO_TRADING_ENABLED=true
# GEMINI_ENABLED=true
